# Copy this file to ".env" and edit it. NEVER commit the real .env file.

# development (default) | production | testing
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development you may leave it empty: a random key is created in instance/.secret_key
SECRET_KEY=

# Optional. Leave empty to use SQLite at instance/events.db
# Production example: DATABASE_URL=sqlite:////var/data/events.db
DATABASE_URL=

# Local server settings used by "python app.py"
HOST=127.0.0.1
PORT=5000
